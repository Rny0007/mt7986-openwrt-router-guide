        "cve_id": "CVE-2020-25681",
        "title": "Dnsmasq DNS Cache Poisoning via Predictable TXID (DNSpooq)",
        "component": "dnsmasq",
        "severity": "HIGH",
        "cvss_score": 8.1,
        "cvss_vector": "CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H",
        "affected_versions": "< 2.83",
